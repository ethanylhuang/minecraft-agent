{
  "name": "minecraft-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Symbolic Minecraft survival primitive harness.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests/*.test.ts",
    "start": "tsx src/index.ts",
    "benchmark:m1": "tsx src/benchmark.ts",
    "verify:m1": "tsx src/verifyM1.ts",
    "demo": "tsx src/demo.ts",
    "smoke": "tsx src/smoke.ts --profile=full",
    "smoke:early": "tsx src/smoke.ts --profile=early"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "minecraft-data": "^3.110.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "vec3": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
